{"data":[{"id":14079409,"text":"The plating on this fountain pen has worn off.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14079406,"text":"\u8fd9\u652f\u94a2\u7b14\u7684\u9540\u5c42\u88ab\u78e8\u6389\u4e86\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14077083,"text":"The cold woke me up in the middle of the night.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14077082,"text":"\u6211\u534a\u591c\u88ab\u51b7\u9192\u4e86\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14067715,"text":"I'll return your CD in a week.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CanonNi","is_unapproved":false,"translations":[{"id":2086657,"text":"\u6211\u8fc7\u4e00\u5468\u628a\u97f3\u789f\u8fd8\u7ed9\u4f60\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"liuzhongjun","is_unapproved":false,"is_direct":true}]},{"id":14063377,"text":"How are you going to talk your way out of this?","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14063376,"text":"\u8fd9\u4f60\u6253\u7b97\u600e\u4e48\u5706\uff1f","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14063345,"text":"We scraped together 200,000 yuan by borrowing from various people.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14063344,"text":"\u6211\u4eec\u4e1c\u62fc\u897f\u51d1\u501f\u5230\u4e8620\u4e07\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14062698,"text":"The best dish I can cook is boiling water.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14062697,"text":"\u6211\u505a\u7684\u6700\u62ff\u624b\u7684\u83dc\u662f\u70e7\u5f00\u6c34\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14062670,"text":"Some of my friends are strongly averse to AI.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14062669,"text":"\u6211\u6709\u4e00\u4e9b\u670b\u53cb\u5f88\u53cd\u611fAI\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14061607,"text":"\"Is this an electronic keyboard?\" \"It's a synthesizer.\"","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14061606,"text":"\u201c\u8fd9\u662f\u7535\u5b50\u7434\u5417\uff1f\u201d\u201c\u8fd9\u662f\u5408\u6210\u5668\u3002\u201d","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14048375,"text":"This isn't a guitar. It's a bass.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14048374,"text":"\u8fd9\u4e0d\u662f\u5409\u4ed6\uff0c\u8fd9\u662f\u8d1d\u65af\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14042568,"text":"Could you hurry up? We're being quite late as it is.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Ooneykcall","is_unapproved":false,"translations":[{"id":14042779,"text":"\u4f60\u80fd\u5feb\u70b9\u5417?\u6211\u4eec\u5df2\u7ecf\u5f88\u665a\u4e86\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"KUI","is_unapproved":false,"is_direct":true}]},{"id":14042389,"text":"Tom wanted to avoid it, but he couldn't.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Ergulis","is_unapproved":false,"translations":[{"id":14042775,"text":"Tom\u60f3\u8981\u907f\u514d\u5374\u505a\u4e0d\u5230\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"KUI","is_unapproved":false,"is_direct":true}]},{"id":14042385,"text":"There are four main types of conditional clauses.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Ergulis","is_unapproved":false,"translations":[{"id":14042772,"text":"\u6761\u4ef6\u72b6\u8bed\u4ece\u53e5\u5305\u542b\u56db\u79cd\u4e3b\u8981\u7c7b\u578b\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"KUI","is_unapproved":false,"is_direct":true}]},{"id":14042369,"text":"He's a rich man and a real maggot.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"maaster","is_unapproved":false,"translations":[{"id":14042771,"text":"\u4ed6\u662f\u4e00\u4f4d\u8111\u6ee1\u80a0\u80a5\u7684\u4eba\u7269\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"KUI","is_unapproved":false,"is_direct":true}]},{"id":14042176,"text":"I'm doing the laundry while the weather is good.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CuteGirlLeia","is_unapproved":false,"translations":[{"id":14042766,"text":"\u5929\u6c14\u597d\u7684\u65f6\u5019\u6211\u4f1a\u53bb\u6d17\u8863\u670d\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"KUI","is_unapproved":false,"is_direct":true}]},{"id":14042174,"text":"This is exactly what I want to talk about.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CuteGirlLeia","is_unapproved":false,"translations":[{"id":14042763,"text":"\u8fd9\u6b63\u662f\u6211\u8981\u8bf4\u7684\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"KUI","is_unapproved":false,"is_direct":true}]},{"id":14042166,"text":"Isn't this room a bit too warm?","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CuteGirlLeia","is_unapproved":false,"translations":[{"id":14042780,"text":"\u8fd9\u95f4\u5c4b\u5b50\u7684\u6e29\u5ea6\u662f\u4e0d\u662f\u6709\u70b9\u9ad8\u4e86\uff1f","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"KUI","is_unapproved":false,"is_direct":true}]},{"id":14042162,"text":"They confirmed to me that there weren't any goods left.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"mexicanhere","is_unapproved":false,"translations":[{"id":14042805,"text":"\u4ed6\u4eec\u5411\u6211\u4fdd\u8bc1\u6ca1\u6709\u4efb\u4f55\u7269\u54c1\u5269\u4e0b\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"KUI","is_unapproved":false,"is_direct":true}]},{"id":14038510,"text":"This bag won't hold an A4 notebook.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14038508,"text":"\u8fd9\u4e2a\u5305\u88c5\u4e0d\u4e0bA4\u7684\u672c\u5b50\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14038502,"text":"An A6 notebook is just a little bigger than a palm.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14038497,"text":"\u4e00\u4e2aA6\u7684\u672c\u5b50\u5927\u6982\u5c31\u6bd4\u5df4\u638c\u5927\u4e00\u70b9\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14038221,"text":"We can't go back to the past.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14038220,"text":"\u6211\u4eec\u4e0d\u53ef\u80fd\u56de\u5230\u8fc7\u53bb\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14038210,"text":"These two portals are connected via a wormhole.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14038208,"text":"\u8fd9\u4e24\u4e2a\u4f20\u9001\u95e8\u901a\u8fc7\u866b\u6d1e\u8fde\u63a5\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14038153,"text":"Do you know what you're in trouble for?","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14038151,"text":"\u77e5\u9053\u72af\u4ec0\u4e48\u4e8b\u4e86\u5417\uff1f","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14037614,"text":"I may not have done it, but I've seen it done.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14037609,"text":"\u6ca1\u5403\u8fc7\u732a\u8089\u8fd8\u6ca1\u89c1\u8fc7\u732a\u8d70\u5417\uff1f","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14036394,"text":"The internet is an immeasurable resource of information.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"LeviHighway","is_unapproved":false,"translations":[{"id":335324,"text":"\u4e92\u8054\u7f51\u662f\u4e00\u79cd\u65e0\u6cd5\u4f30\u91cf\u7684\u4fe1\u606f\u8d44\u6e90\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":14036072,"text":"My nephew is more than twenty years older than me.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"LeviHighway","is_unapproved":false,"translations":[{"id":14036071,"text":"\u6211\u7684\u59ea\u5b50\u6bd4\u6211\u5927\u4e86\u4e8c\u5341\u4f86\u6b72\u3002","lang":"cmn","script":"Hant","license":"CC BY 2.0 FR","owner":"LeviHighway","is_unapproved":false,"is_direct":true}]},{"id":14034677,"text":"The meteorological bureau has issued a red rainstorm alert.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14034673,"text":"\u6c14\u8c61\u5c40\u53d1\u5e03\u4e86\u66b4\u96e8\u7ea2\u8272\u9884\u8b66\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14034672,"text":"There's standing water all over the road.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14034664,"text":"\u8def\u9762\u4e0a\u90fd\u662f\u79ef\u6c34\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14034592,"text":"You refuse a toast, only to be forced to drink a forfeit.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"LeviHighway","is_unapproved":false,"translations":[{"id":14034585,"text":"\u656c\u9152\u4e0d\u5403\u5403\u7f70\u9152\u3002","lang":"cmn","script":"Hant","license":"CC BY 2.0 FR","owner":"LeviHighway","is_unapproved":false,"is_direct":true}]},{"id":14029040,"text":"They considered him the best doctor in town.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"LeviHighway","is_unapproved":false,"translations":[{"id":636203,"text":"\u4ed6\u4eec\u628a\u4ed6\u89c6\u4e3a\u57ce\u91cc\u6700\u597d\u7684\u533b\u751f\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"sysko","is_unapproved":false,"is_direct":true}]},{"id":14029038,"text":"They consider him the best doctor in town.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"LeviHighway","is_unapproved":false,"translations":[{"id":636203,"text":"\u4ed6\u4eec\u628a\u4ed6\u89c6\u4e3a\u57ce\u91cc\u6700\u597d\u7684\u533b\u751f\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"sysko","is_unapproved":false,"is_direct":true}]},{"id":14029037,"text":"They regard him as the best doctor in town.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"LeviHighway","is_unapproved":false,"translations":[{"id":636203,"text":"\u4ed6\u4eec\u628a\u4ed6\u89c6\u4e3a\u57ce\u91cc\u6700\u597d\u7684\u533b\u751f\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"sysko","is_unapproved":false,"is_direct":true}]},{"id":14029033,"text":"How long have you been dealing with this trouble?","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"LeviHighway","is_unapproved":false,"translations":[{"id":10510869,"text":"\u4f60\u6709\u9019\u7169\u60f1\u591a\u4e45\u4e86\uff1f","lang":"cmn","script":"Hant","license":"CC BY 2.0 FR","owner":"DaoSeng","is_unapproved":false,"is_direct":true}]},{"id":14029028,"text":"Would you like a bit of chocolate cheese?","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"LeviHighway","is_unapproved":false,"translations":[{"id":414151,"text":"\u60f3\u5403\u4e00\u70b9\u5de7\u514b\u529b\u5976\u916a\u5417\uff1f","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"GlossaMatik","is_unapproved":false,"is_direct":true}]},{"id":14029025,"text":"The slowest promise is always the most faithful credit.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"LeviHighway","is_unapproved":false,"translations":[{"id":502844,"text":"\u6700\u6162\u7684\u627f\u8bfa\u6c38\u8fdc\u662f\u6700\u5fe0\u5b9e\u7684\u4fe1\u7528\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":14028851,"text":"Many people are skeptical about the actual effects of traditional Chinese medicine.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14028850,"text":"\u5f88\u591a\u4eba\u5bf9\u4e2d\u836f\u7684\u771f\u5b9e\u6548\u679c\u6301\u6000\u7591\u6001\u5ea6\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14028841,"text":"The doctor prescribed two acetaminophen\u2011caffeine tablets for me.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14028835,"text":"\u533b\u751f\u7ed9\u6211\u5f00\u4e86\u4e24\u7c92\u915a\u5496\u7247\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14028821,"text":"I took the medicine, but it didn't work at all.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14028816,"text":"\u6211\u5403\u4e86\u836f\uff0c\u4f46\u5b8c\u5168\u6ca1\u6548\u679c\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14028793,"text":"Then why don't you call the police?","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14028789,"text":"\u90a3\u4f60\u4e3a\u4ec0\u4e48\u4e0d\u62a5\u8b66\u5462\uff1f","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14028764,"text":"Don't generalize individual behavior to an entire group.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"translations":[{"id":14028761,"text":"\u4e0d\u8981\u628a\u4e2a\u4eba\u884c\u4e3a\u4e0a\u5347\u5230\u96c6\u4f53\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"jan_OkulaJu","is_unapproved":false,"is_direct":true}]},{"id":14028322,"text":"In the park there are many couples who are walking.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"enclectm","is_unapproved":false,"translations":[{"id":14028321,"text":"\u516c\u56ed\u91cc\u6709\u8bb8\u591a\u6563\u6b65\u7684\u60c5\u4fa3\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"enclectm","is_unapproved":false,"is_direct":true}]},{"id":14028320,"text":"We will do our best to help you.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"enclectm","is_unapproved":false,"translations":[{"id":14028319,"text":"\u6211\u4eec\u4f1a\u5c3d\u529b\u5e2e\u52a9\u4f60\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"enclectm","is_unapproved":false,"is_direct":true}]},{"id":14028318,"text":"He ran too fast; when he stopped, he was panting.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"enclectm","is_unapproved":false,"translations":[{"id":14028317,"text":"\u4ed6\u8dd1\u5f97\u592a\u5feb\uff0c\u505c\u4e0b\u6765\u65f6\u6c14\u5401\u5401\u7684\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"enclectm","is_unapproved":false,"is_direct":true}]},{"id":14028312,"text":"The forest in the fall is splendidly colorful, a thoroughly enchanting sight.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"enclectm","is_unapproved":false,"translations":[{"id":14028311,"text":"\u79cb\u5929\u7684\u68ee\u6797\u4e94\u5f69\u6591\u6593\uff0c\u666f\u8272\u5341\u5206\u8ff7\u4eba\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"enclectm","is_unapproved":false,"is_direct":true}]},{"id":14027278,"text":"The injured bird struggled with all its might on the grass.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"enclectm","is_unapproved":false,"translations":[{"id":14027276,"text":"\u90a3\u53ea\u53d7\u4f24\u7684\u5c0f\u9e1f\u5728\u8349\u5730\u4e0a\u5c3d\u529b\u6323\u624e\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"enclectm","is_unapproved":false,"is_direct":true}]},{"id":14027275,"text":"When her friend was sad, she comforted him.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"enclectm","is_unapproved":false,"translations":[{"id":14027274,"text":"\u670b\u53cb\u4f24\u5fc3\u65f6\uff0c\u5979\u8f7b\u58f0\u5b89\u6170\u4ed6\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"enclectm","is_unapproved":false,"is_direct":true}]},{"id":14027273,"text":"When the wound got infected, he experienced a bout of unbearable pain.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"enclectm","is_unapproved":false,"translations":[{"id":14027271,"text":"\u4f24\u53e3\u53d1\u708e\u540e\uff0c\u4ed6\u611f\u5230\u96be\u5fcd\u65e0\u6bd4\u7684\u5267\u75db\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"enclectm","is_unapproved":false,"is_direct":true}]},{"id":14022947,"text":"After taking a shower I drank a soda.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"frpzzd","is_unapproved":false,"translations":[{"id":8591228,"text":"\u6211\u6d17\u5b8c\u6fa1\u4e4b\u540e\u559d\u4e86\u70b9\u6c7d\u6c34\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"easononizuka","is_unapproved":false,"is_direct":true}]},{"id":14022937,"text":"I still haven't ever written a resum\u00e9!","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"frpzzd","is_unapproved":false,"translations":[{"id":1743522,"text":"\u6211\u8fd8\u4ece\u6765\u90fd\u6ca1\u6709\u5199\u8fc7\u7b80\u5386\u5462\uff01","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"sadhen","is_unapproved":false,"is_direct":true}]},{"id":14022694,"text":"An octopus can release ink when it gets into danger.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"frpzzd","is_unapproved":false,"translations":[{"id":13884043,"text":"\u7ae0\u9b5a\u9047\u5230\u5371\u96aa\u6642\u6703\u5674\u51fa\u58a8\u6c41\u3002","lang":"cmn","script":"Hant","license":"CC BY 2.0 FR","owner":"LeviHighway","is_unapproved":false,"is_direct":true}]},{"id":14022693,"text":"Could you take a look at what my little sister is doing?","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"frpzzd","is_unapproved":false,"translations":[{"id":10460397,"text":"\u8bf7\u770b\u4e00\u4e0b\u6211\u59b9\u59b9\u5728\u505a\u4ec0\u4e48\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"GlossaMatik","is_unapproved":false,"is_direct":true}]}],"paging":{"total":18579,"has_next":tru