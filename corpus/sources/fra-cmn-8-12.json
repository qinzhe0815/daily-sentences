e8b\u7269\u3002","lang":"cmn","script":"Hant","license":"CC BY 2.0 FR","owner":"nickyeow","is_unapproved":false,"is_direct":true}]},{"id":3180,"text":"La plupart des gens \u00e9crivent \u00e0 propos de leur vie quotidienne.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":346458,"text":"\u5927\u90e8\u5206\u4eba\u5199\u7684\u4e1c\u897f\u662f\u5173\u4e8e\u4ed6\u4eec\u7684\u65e5\u5e38\u751f\u6d3b\u7684\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3181,"text":"Si je pouvais t'envoyer un marshmallow, Trang, je le ferais.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":501338,"text":"Trang\uff0c\u5982\u679c\u6211\u80fd\u5bc4\u7ed9\u4f60\u4e00\u4e2a\u68c9\u82b1\u7cd6\uff0c\u6211\u4f1a\u8fd9\u4e48\u505a\u7684\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3182,"text":"Pour faire cela, il te faut prendre des risques.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":501339,"text":"\u8981\u8fd9\u4e48\u505a\uff0c\u4f60\u9700\u8981\u5192\u9669\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3190,"text":"Peut-\u00eatre que ce sera la m\u00eame chose pour lui.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":501345,"text":"\u53ef\u80fd\u8fd9\u5bf9\u4ed6\u662f\u4e00\u56de\u4e8b\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3192,"text":"Les humains n'ont jamais \u00e9t\u00e9 faits pour vivre \u00e9ternellement.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":501347,"text":"\u4eba\u7c7b\u751f\u51fa\u6765\u4e0d\u662f\u4e3a\u4e86\u6c38\u4e45\u751f\u5b58\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3194,"text":"Je pense que j'ai une th\u00e9orie \u00e0 ce sujet.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":501348,"text":"\u6211\u60f3\u6211\u5bf9\u8fd9\u4e2a\u4e3b\u9898\u6709\u4e00\u5957\u7406\u8bba\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3197,"text":"Je n\u2019ai pas de compte sur ces forums.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"zmoo","is_unapproved":false,"translations":[{"id":501352,"text":"\u6211\u5728\u8fd9\u4e9b\u8bba\u575b\u4e0a\u6ca1\u6709\u5e10\u53f7\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3199,"text":"Je ne savais pas d'o\u00f9 \u00e7a venait.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":58,"text":"\u6211\u4e0d\u77e5\u9053\u5b83\u662f\u4ece\u54ea\u91cc\u6765\u7684\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3204,"text":"Tu ne fais que fuir les probl\u00e8mes de la vie.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":501364,"text":"\u4f60\u53ea\u4f1a\u9003\u907f\u751f\u6d3b\u95ee\u9898\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3205,"text":"Si tu regardes les paroles, elles ne signifient pas vraiment grand-chose.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":501365,"text":"\u5982\u679c\u4f60\u770b\u6b4c\u8bcd\uff0c\u90a3\u771f\u7684\u6ca1\u4ec0\u4e48\u5927\u610f\u601d\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3206,"text":"Il y a un probl\u00e8me que tu ne vois pas.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":501366,"text":"\u6709\u4e2a\u95ee\u9898\u4f60\u6ca1\u6709\u60f3\u5230\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3208,"text":"Mon prof de physique s'en fiche si je s\u00e8che les cours.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":358065,"text":"\u6211\u7684\u7269\u7406\u8001\u5e08\u4e0d\u5728\u4e4e\u6211\u662f\u5426\u9003\u8bfe\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"mountaintree","is_unapproved":false,"is_direct":true}]},{"id":3210,"text":"Je d\u00e9teste \u00e7a quand il y a trop de gens.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"zmoo","is_unapproved":false,"translations":[{"id":501372,"text":"\u6211\u8ba8\u538c\u4eba\u592a\u591a\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3213,"text":"Je ne t'en demanderai pas plus pour aujourd'hui.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":501376,"text":"\u4eca\u5929\u6211\u5c31\u4e0d\u518d\u95ee\u4f60\u4e86\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3214,"text":"Il se peut qu'il g\u00e8le la semaine prochaine.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Tcha","is_unapproved":false,"translations":[{"id":501377,"text":"\u4e0b\u5468\u53ef\u80fd\u4f1a\u7ed3\u51b0\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3215,"text":"M\u00eame s'il s'est excus\u00e9, je suis encore en col\u00e8re.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Tcha","is_unapproved":false,"translations":[{"id":454663,"text":"\u5373\u4f7f\u4ed6\u9053\u6b49\u4e86\uff0c\u6211\u8fd8\u662f\u5f88\u6124\u6012\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"peipei","is_unapproved":false,"is_direct":true}]},{"id":3220,"text":"Th\u00e9oriquement, je suis en train de faire des maths.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Tcha","is_unapproved":false,"translations":[{"id":501397,"text":"\u7406\u8bba\u4e0a\uff0c\u6211\u6b63\u5728\u505a\u6570\u5b66\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3221,"text":"Qu'est-ce qui s'est pass\u00e9\u202f?","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Tcha","is_unapproved":false,"translations":[{"id":501399,"text":"\u53d1\u751f\u4e86\u4ec0\u4e48\uff1f","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3224,"text":"Je ne sais pas ce que tu veux dire.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Tcha","is_unapproved":false,"translations":[{"id":501403,"text":"\u6211\u4e0d\u77e5\u9053\u4f60\u60f3\u8bf4\u4ec0\u4e48\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3225,"text":"Il faut bien que mon ordinateur me serve \u00e0 quelque chose.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"zmoo","is_unapproved":false,"translations":[{"id":501404,"text":"\u6211\u7684\u7535\u8111\u5e94\u8be5\u8981\u5bf9\u6211\u6709\u7528\u5904\u624d\u597d\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3229,"text":"On ne peut pas tout attendre des \u00e9coles.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Tcha","is_unapproved":false,"translations":[{"id":501412,"text":"\u6211\u4eec\u65e0\u6cd5\u671f\u671b\u4ece\u5b66\u6821\u5b66\u5230\u6240\u6709\u7684\u4e1c\u897f\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3230,"text":"Il y a beaucoup de mots que je ne comprends pas.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"SUZIE","is_unapproved":false,"translations":[{"id":345992,"text":"\u6709\u5f88\u591a\u5b57\u6211\u4e0d\u61c2\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3236,"text":"Est-ce qu'on peut formuler \u00e7a d'une autre mani\u00e8re\u202f?","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Tcha","is_unapproved":false,"translations":[{"id":501420,"text":"\u53ef\u4ee5\u7528\u53e6\u4e00\u79cd\u65b9\u6cd5\u7ec4\u7ec7\u4e00\u4e0b\u5417\uff1f","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3240,"text":"Sauf que l\u00e0, c'est pas si simple.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Tcha","is_unapproved":false,"translations":[{"id":335069,"text":"\u9664\u4e86\u8fd9\u91cc\uff0c\u6ca1\u90a3\u4e48\u7b80\u5355\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]}],"paging":{"total":7394,"has_next":true,"next":"https:\/\/api.tatoeba.org\/v1\/sentences?lang=fra&trans%3Alang=cmn&trans%3Ais_direct=yes&is_unapproved=no&is_orphan=no&trans%3Ais_unapproved=no&trans%3Ais_orphan=no&showtrans=matching&limit=60&sort=-created&word_count=8-12&after=0%2C3240"}}
