n.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":36,"text":"\u6211\u66fe\u7d93\u60f3\u904e\u7576\u500b\u592a\u7a7a\u7269\u7406\u5b78\u5bb6\u3002","lang":"cmn","script":"Hant","license":"CC BY 2.0 FR","owner":"Martha","is_unapproved":false,"is_direct":true}]},{"id":3138,"text":"La plupart des gens pensent que je suis fou.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":39,"text":"\u5927\u90e8\u4efd\u7684\u4eba\u89ba\u5f97\u6211\u760b\u4e86\u3002","lang":"cmn","script":"Hant","license":"CC BY 2.0 FR","owner":"Martha","is_unapproved":false,"is_direct":true}]},{"id":3139,"text":"Non je ne le suis pas, c'est toi qui l'es\u202f!","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":40,"text":"\u4e0d\uff0c\u6211\u4e0d\u662f\uff01\u4f60\u624d\u662f\uff01","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"sysko","is_unapproved":false,"is_direct":true}]},{"id":3150,"text":"Est-ce que tu te fous de moi\u202f?\u202f!","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":48,"text":"\u4f60\u662f\u5728\u8ddf\u6211\u958b\u73a9\u7b11\u5427\uff1f\uff01","lang":"cmn","script":"Hant","license":"CC BY 2.0 FR","owner":"nickyeow","is_unapproved":false,"is_direct":true}]},{"id":3151,"text":"C'est la chose la plus stupide que j'ai jamais dite.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":899750,"text":"\u6211\u66fe\u8bf4\u8fc7\u7684\u5e9f\u8bdd\u5f53\u4e2d\u90a3\u662f\u6700\u611a\u8822\u7684\u4e00\u53e5\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"shanghainese","is_unapproved":false,"is_direct":true}]},{"id":3152,"text":"Je ne veux pas \u00eatre lamentable, je veux \u00eatre cool !\u202f!","lang":"fra","script":null,"license":"CC B