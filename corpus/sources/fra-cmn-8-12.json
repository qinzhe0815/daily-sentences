"ANH_DAO","is_unapproved":false,"translations":[{"id":501326,"text":"\u6709\u65f6\u5019\u6211\u4f1a\u5fcd\u4e0d\u4f4f\u628a\u60c5\u7eea\u6446\u5728\u8138\u4e0a\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3166,"text":"C'est un mot pour lequel j'aimerais trouver un substitut.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":501327,"text":"\u8fd9\u5c31\u662f\u6211\u60f3\u8981\u66ff\u4ee3\u7684\u90a3\u4e2a\u8bcd\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3167,"text":"Ce serait quelque chose qu'il faudrait que je programme.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":501328,"text":"\u8fd9\u662f\u6211\u8be5\u8ba1\u5212\u7684\u4e8b\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3168,"text":"Il n'est pas dans mon intention d'\u00eatre \u00e9go\u00efste.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":501330,"text":"\u81ea\u79c1\u4e0d\u662f\u6211\u7684\u672c\u610f\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3170,"text":"Combien d'amis proches est-ce que tu as\u202f?","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":501332,"text":"\u4f60\u6709\u591a\u5c11\u81f3\u4ea4\uff1f","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":3172,"text":"C'est toujours tel que \u00e7a a \u00e9t\u00e9.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":346476,"t