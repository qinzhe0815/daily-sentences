{"data":[{"id":1276,"text":"Let's try something.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":3091,"text":"Essayons quelque chose\u202f!","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":456963,"text":"Tentons quelque chose\u202f!","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true},{"id":7485970,"text":"Essayons quelque chose.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"theachaean","is_unapproved":false,"is_direct":true}]},{"id":1277,"text":"I have to go to sleep.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"vinhan","is_unapproved":false,"translations":[{"id":373908,"text":"Je dois aller dormir.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"zmoo","is_unapproved":false,"is_direct":true},{"id":7306705,"text":"Il faut que j'aille dormir.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"manou85","is_unapproved":false,"is_direct":true}]},{"id":1282,"text":"Muiriel is 20 now.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"LeeSooHa","is_unapproved":false,"translations":[{"id":3097,"text":"Muiriel a 20 ans maintenant.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":456983,"text":"Muiriel a d\u00e9sormais 20 ans.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true}]},{"id":1283,"text":"The password is \"Muiriel\".","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"wuiwie","is_unapproved":false,"translations":[{"id":3098,"text":"Le mot de passe est \u00ab Muiriel \u00bb.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true}]},{"id":1284,"text":"I will be back soon.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"brauliobezerra","is_unapproved":false,"translations":[{"id":3099,"text":"Je serai bient\u00f4t de retour.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":11864,"text":"Je serai de retour dans une minute.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Lulantis","is_unapproved":false,"is_direct":true},{"id":530392,"text":"Je reviens tout de suite.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"fs","is_unapproved":false,"is_direct":true},{"id":895812,"text":"Je reviens vite.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"U2FS","is_unapproved":false,"is_direct":true},{"id":911747,"text":"Je reviens de suite.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true}]},{"id":1286,"text":"I'm at a loss for words.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"wakaran","is_unapproved":false,"translations":[{"id":3101,"text":"J'en perds mes mots.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":497820,"text":"Les mots me manquent.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"aandrusiak","is_unapproved":false,"is_direct":true},{"id":571863,"text":"Les mots me font d\u00e9faut.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true},{"id":965413,"text":"Je ne trouve pas les mots.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true}]},{"id":1287,"text":"This is never going to end.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":3102,"text":"\u00c7a ne va jamais finir.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":965410,"text":"\u00c7a n'en finira jamais.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true},{"id":7132541,"text":"\u00c7a n'en finit plus.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"AmarMecheri","is_unapproved":false,"is_direct":true}]},{"id":1289,"text":"That was an evil bunny.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"djinni74","is_unapproved":false,"translations":[{"id":3104,"text":"C\u2019\u00e9tait un m\u00e9chant lapin.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"zmoo","is_unapproved":false,"is_direct":true},{"id":7469468,"text":"C\u2019\u00e9tait un lapin mal\u00e9fique.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Micsmithel","is_unapproved":false,"is_direct":true},{"id":7469470,"text":"C\u2019\u00e9tait un lapin diabolique.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Micsmithel","is_unapproved":false,"is_direct":true}]},{"id":1290,"text":"I was in the mountains.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":3105,"text":"J'\u00e9tais dans les montagnes.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":7469473,"text":"Je me trouvais dans les montagnes.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Micsmithel","is_unapproved":false,"is_direct":true},{"id":10830301,"text":"J'\u00e9tais \u00e0 la montagne.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"lbdx","is_unapproved":false,"is_direct":true}]},{"id":1291,"text":"Is it a recent picture?","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Swift","is_unapproved":false,"translations":[{"id":3106,"text":"Est-ce que c'est une photo r\u00e9cente\u202f?","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":1309675,"text":"Est-ce une photo r\u00e9cente\u202f?","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true}]},{"id":1294,"text":"Education in this world disappoints me.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"wuiwie","is_unapproved":false,"translations":[{"id":3110,"text":"L'\u00e9ducation dans ce monde me d\u00e9\u00e7oit.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true}]},{"id":1296,"text":"You are in my way.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":376666,"text":"Tu es sur mon chemin.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"TRANG","is_unapproved":false,"is_direct":true},{"id":528865,"text":"Vous \u00eates sur mon chemin.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true},{"id":9420416,"text":"Vous vous trouvez en travers de mon chemin.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true},{"id":9420419,"text":"Tu te trouves en travers de mon chemin.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true}]},{"id":1298,"text":"This will cost \u20ac30.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"djinni74","is_unapproved":false,"translations":[{"id":3114,"text":"\u00c7a co\u00fbtera 30 \u20ac.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":3660025,"text":"\u00c7a va faire 30 euros.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"THURET","is_unapproved":false,"is_direct":true}]},{"id":1299,"text":"I make \u20ac100 a day.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"brauliobezerra","is_unapproved":false,"translations":[{"id":3115,"text":"Je gagne 100 \u20ac par jour.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":1089996,"text":"Je gagne cent euros par jour.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"fs","is_unapproved":false,"is_direct":true}]},{"id":1302,"text":"That won't happen.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"human600","is_unapproved":false,"translations":[{"id":3118,"text":"\u00c7a n'arrivera pas.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":12389066,"text":"Cela ne se produira pas.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Adelpa","is_unapproved":false,"is_direct":true}]},{"id":1303,"text":"Sometimes he can be a strange guy.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"djinni74","is_unapproved":false,"translations":[{"id":3119,"text":"Parfois il peut \u00eatre un gars bizarre.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":458491,"text":"Il peut parfois \u00eatre un gar\u00e7on \u00e9trange.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true},{"id":7469553,"text":"Ce mec est bizarre par moment.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Micsmithel","is_unapproved":false,"is_direct":true}]},{"id":1308,"text":"I miss you.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"brauliobezerra","is_unapproved":false,"translations":[{"id":3124,"text":"Tu me manques.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":385358,"text":"Vous me manquez.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"MUIRIEL","is_unapproved":false,"is_direct":true}]},{"id":1310,"text":"I always liked mysterious characters more.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"human600","is_unapproved":false,"translations":[{"id":3126,"text":"J'ai toujours plus appr\u00e9ci\u00e9 les personnages myst\u00e9rieux.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":373635,"text":"J\u2019ai toujours pr\u00e9f\u00e9r\u00e9 les personnages myst\u00e9rieux.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"zmoo","is_unapproved":false,"is_direct":true}]},{"id":1311,"text":"You should sleep.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":3127,"text":"Tu devrais dormir.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Pharamp","is_unapproved":false,"is_direct":true}]},{"id":1312,"text":"I'm going to go.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"axcutul","is_unapproved":false,"translations":[{"id":378541,"text":"Je vais y aller.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Pharamp","is_unapproved":false,"is_direct":true}]},{"id":1314,"text":"You're so impatient with me.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CM","is_unapproved":false,"translations":[{"id":3130,"text":"Tu es tellement impatiente avec moi.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":3782866,"text":"Tu es tellement impatient avec moi.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Scorpionvenin14","is_unapproved":false,"is_direct":true}]},{"id":1316,"text":"I once wanted to be an astrophysicist.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"papabear","is_unapproved":false,"translations":[{"id":3132,"text":"Il fut un temps o\u00f9 je voulais \u00eatre astrophysicien.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true}]},{"id":1317,"text":"I never liked biology.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"brauliobezerra","is_unapproved":false,"translations":[{"id":3133,"text":"Je n'ai jamais aim\u00e9 la biologie.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true}]},{"id":1320,"text":"It is unfortunately true.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":3136,"text":"C'est malheureusement vrai.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true}]},{"id":1322,"text":"Most people think I'm crazy.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":3138,"text":"La plupart des gens pensent que je suis fou.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":7482022,"text":"La plupart des gens pensent que je suis cingl\u00e9.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"theachaean","is_unapproved":false,"is_direct":true}]},{"id":1323,"text":"No I'm not; you are!","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":3139,"text":"Non je ne le suis pas, c'est toi qui l'es\u202f!","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":1569940,"text":"Non, ce n'est pas moi, c'est toi !","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Rovo","is_unapproved":false,"is_direct":true}]},{"id":1324,"text":"That's MY line!","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"human600","is_unapproved":false,"translations":[{"id":3140,"text":"C'est ma r\u00e9plique\u202f!","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true}]},{"id":1325,"text":"He's kicking me!","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":3141,"text":"Il me donne des coups de pied\u202f!","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true}]},{"id":1326,"text":"Are you sure?","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"brauliobezerra","is_unapproved":false,"translations":[{"id":3142,"text":"Est-ce que tu es s\u00fbr\u202f?","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":135241,"text":"Es-tu s\u00fbr\u202f?","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true},{"id":558534,"text":"Es-tu s\u00fbre\u202f?","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true},{"id":558535,"text":"\u00cates-vous s\u00fbr\u202f?","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true},{"id":558536,"text":"\u00cates-vous s\u00fbre\u202f?","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true},{"id":558537,"text":"\u00cates-vous s\u00fbres\u202f?","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true},{"id":558538,"text":"\u00cates-vous s\u00fbrs\u202f?","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true},{"id":10672751,"text":"Tu es s\u00fbr\u00a0?","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"AutoBot","is_unapproved":false,"is_direct":true},{"id":13589012,"text":"Tu es s\u00fbre ?","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Adelpa","is_unapproved":false,"is_direct":true}]},{"id":1327,"text":"Then there is a problem...","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":3143,"text":"Alors il y a un probl\u00e8me...","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true}]},{"id":1328,"text":"Oh, there's a butterfly!","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"brauliobezerra","is_unapproved":false,"translations":[{"id":3144,"text":"Oh, il y a un papillon\u202f!","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":5647221,"text":"Oh, un papillon !","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Adelpa","is_unapproved":false,"is_direct":true},{"id":7482023,"text":"Oh, il y a un papillon !","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"theachaean","is_unapproved":false,"is_direct":true}]},{"id":1330,"text":"It doesn't surprise me.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":3146,"text":"\u00c7a ne me surprend pas.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":522459,"text":"Cela ne me surprend pas.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true}]},{"id":1333,"text":"It depends on the context.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":3149,"text":"\u00c7a d\u00e9pend du contexte.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true}]},{"id":1334,"text":"Are you freaking kidding me?!","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"AlanF_US","is_unapproved":false,"translations":[{"id":3150,"text":"Est-ce que tu te fous de moi\u202f?\u202f!","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":3782869,"text":"Est-ce que tu te fous de moi ?","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Julien_PDC","is_unapproved":false,"is_direct":true}]},{"id":1339,"text":"I'm so fat.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":3155,"text":"Je suis si gros.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":7482030,"text":"Je suis tellement gros.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"theachaean","is_unapproved":false,"is_direct":true},{"id":8691463,"text":"Je suis tellement grosse.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true}]},{"id":1341,"text":"I'm gonna shoot him.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"human600","is_unapproved":false,"translations":[{"id":3157,"text":"Je vais le descendre.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"chika","is_unapproved":false,"is_direct":true},{"id":8315201,"text":"Je vais lui coller une balle entre les deux yeux.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"Micsmithel","is_unapproved":false,"is_direct":true}]},{"id":1343,"text":"I'm just saying!","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":3159,"text":"Je ne fais que parler\u202f!","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"zmoo","is_unapproved":false,"is_direct":true}]},{"id":1344,"text":"That was probably what influenced their decision.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":3160,"text":"C'\u00e9tait probablement ce qui a influenc\u00e9 leur d\u00e9cision.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true}]},{"id":1346,"text":"This is what I would have said.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":3162,"text":"C'est ce que j'aurais dit.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true}]},{"id":1348,"text":"That's because you're a girl.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":3164,"text":"C'est parce que tu es une fille.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":3251518,"text":"C'est parce que t'es une nana.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true}]},{"id":1349,"text":"Sometimes I can't help showing emotions.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":3165,"text":"Parfois je ne peux pas m'emp\u00eacher de montrer des \u00e9motions.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true}]},{"id":1352,"text":"I don't intend to be selfish.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":3168,"text":"Il n'est pas dans mon intention d'\u00eatre \u00e9go\u00efste.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true}]},{"id":1354,"text":"How many close friends do you have?","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"al_ex_an_der","is_unapproved":false,"translations":[{"id":3170,"text":"Combien d'amis proches est-ce que tu as\u202f?","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true},{"id":558543,"text":"Combien d'amis proches avez-vous\u202f?","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":false,"is_direct":true}]},{"id":1358,"text":"One can always find time.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"brauliobezerra","is_unapproved":false,"translations":[{"id":3174,"text":"On peut toujours trouver du temps.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true}]},{"id":1361,"text":"When I woke up, I was sad.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"100nosewiggles","is_unapproved":false,"translations":[{"id":3177,"text":"Quand je me suis r\u00e9veill\u00e9 j'\u00e9tais triste.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"TRANG","is_unapproved":false,"is_direct":true}]},{"id":1362,"text":"That is somewhat explained at the end.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":11255738,"text":"C'est un peu expliqu\u00e9 \u00e0 la fin.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"lbdx","is_unapproved":false,"is_direct":true}]},{"id":1364,"text":"Most people write about their daily life.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":3180,"text":"La plupart des gens \u00e9crivent \u00e0 propos de leur vie quotidienne.","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"is_direct":true}]},{"id":1368,"text":"Why do you ask?","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":3184,"text":"Pourquoi demandes-tu\u202f?","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sysko","is_unapproved":false,"is_direct":true}]},{"id":1373,"text":"How long did you stay?","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":3189,"text":"Combien de temps es-tu rest\u00e9e\u202f?","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sysko","is_unapproved":false,"is_direct":true},{"id":1140320,"text":"Combien de temps y avez-vous s\u00e9journ\u00e9 ?","lang":"fra","script":null,"license":"CC BY 2.0 FR","owner":"sacredceltic","is_unapproved":fals