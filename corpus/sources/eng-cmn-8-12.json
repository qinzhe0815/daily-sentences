{"data":[{"id":1280,"text":"Today is June 18th and it is Muiriel's birthday!","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"wuiwie","is_unapproved":false,"translations":[{"id":5,"text":"\u4eca\u5929\u662f\uff16\u6708\uff11\uff18\u53f7\uff0c\u4e5f\u662fMuiriel\u7684\u751f\u65e5\uff01","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"is_direct":true}]},{"id":1288,"text":"I just don't know what to say.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":13,"text":"\u6211\u53ea\u662f\u4e0d\u77e5\u9053\u61c9\u8a72\u8aaa\u4ec0\u9ebc\u800c\u5df2\u2026\u2026","lang":"cmn","script":"Hant","license":"CC BY 2.0 FR","owner":"tatomeimei","is_unapproved":false,"is_direct":true},{"id":458549,"text":"\u6211\u5c31\u662f\u4e0d\u77e5\u9053\u8aaa\u4e9b\u4ec0\u9ebc\u3002","lang":"cmn","script":"Hant","license":"CC BY 2.0 FR","owner":"Rebeca","is_unapproved":false,"is_direct":true}]},{"id":1292,"text":"I don't know if I have the time.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Ramses","is_unapproved":false,"translations":[{"id":17,"text":"\u6211\u4e0d\u77e5\u9053\u6211\u6709\u6c92\u6709\u6642\u9593\u3002","lang":"cmn","script":"Hant","license":"CC BY 2.0 FR","owner":"Martha","is_unapproved":false,"is_direct":true}]},{"id":1295,"text":"You're in better shape than I am.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":900252,"text":"\u4f60\u7684\u9ad4\u578b\u6bd4\u6211\u7684\u597d\u3002","lang":"cmn","script":"Hant","license":"CC BY 2.0 FR","owner":"Martha","is_unapproved":false,"is_direct":true}]},{"id":1300,"text":"I may give up soon and just nap instead.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"brauliobezerra","is_unapproved":false,"translations":[{"id":25,"text":"\u4e5f\u8bb8\u6211\u4f1a\u9a6c\u4e0a\u653e\u5f03\u7136\u540e\u53bb\u6253\u76f9\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1304,"text":"I'll do my best not to disturb your studying.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"djinni74","is_unapproved":false,"translations":[{"id":27,"text":"\u6211\u4f1a\u5c3d\u91cf\u4e0d\u6253\u6270\u4f60\u590d\u4e60\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1305,"text":"I can only wonder if this is the same for everyone else.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"YVasev","is_unapproved":false,"translations":[{"id":501302,"text":"\u6211\u53ea\u80fd\u95ee\u81ea\u5df1\u8fd9\u5bf9\u5176\u4ed6\u6240\u6709\u4eba\u662f\u4e0d\u662f\u4e00\u56de\u4e8b\u5462\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1309,"text":"I'll call them tomorrow when I come back.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"papabear","is_unapproved":false,"translations":[{"id":30,"text":"\u6211\u660e\u5929\u56de\u4f86\u7684\u6642\u5019\u6703\u8ddf\u4ed6\u5011\u806f\u7d61\u3002","lang":"cmn","script":"Hant","license":"CC BY 2.0 FR","owner":"nickyeow","is_unapproved":false,"is_direct":true}]},{"id":1313,"text":"I told them to send me another ticket.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":34,"text":"\u6211\u8acb\u4ed6\u5011\u518d\u5bc4\u7d66\u6211\u4e00\u5f35\u7968\u3002","lang":"cmn","script":"Hant","license":"CC BY 2.0 FR","owner":"Martha","is_unapproved":false,"is_direct":true}]},{"id":1315,"text":"I can't live that kind of life.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":35,"text":"\u6211\u4e0d\u80fd\u8fd9\u6837\u6d3b\u7740\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"is_direct":true},{"id":863000,"text":"\u90a3\u79cd\u751f\u6d3b\u65b9\u5f0f\u4e0d\u9002\u5408\u6211\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"edelyn90","is_unapproved":false,"is_direct":true}]},{"id":1318,"text":"The last person I told my idea to thought I was nuts.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":501305,"text":"\u6700\u540e\u4e00\u4e2a\u542c\u6211\u8bf4\u6211\u7684\u4e3b\u610f\u7684\u4eba\u8ba4\u4e3a\u6211\u75af\u4e86\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1332,"text":"For some reason I feel more alive at night.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":874484,"text":"\u4e0d\u77e5\u9053\u70ba\u4ec0\u9ebc\u6211\u591c\u88e1\u89ba\u5f97\u6bd4\u8f03\u6709\u6d3b\u529b\u3002","lang":"cmn","script":"Hant","license":"CC BY 2.0 FR","owner":"Martha","is_unapproved":false,"is_direct":true}]},{"id":1335,"text":"That's the stupidest thing I've ever said.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"wakaran","is_unapproved":false,"translations":[{"id":335708,"text":"\u90a3\u662f\u6211\u8bf4\u8fc7\u7684\u6700\u611a\u8822\u7684\u8bdd\u4e86\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true},{"id":899750,"text":"\u6211\u66fe\u8bf4\u8fc7\u7684\u5e9f\u8bdd\u5f53\u4e2d\u90a3\u662f\u6700\u611a\u8822\u7684\u4e00\u53e5\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"shanghainese","is_unapproved":false,"is_direct":true}]},{"id":1337,"text":"When I grow up, I want to be a king.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":49,"text":"\u6211\u9577\u5927\u5f8c\u60f3\u7576\u570b\u738b\u3002","lang":"cmn","script":"Hant","license":"CC BY 2.0 FR","owner":"nickyeow","is_unapproved":false,"is_direct":true}]},{"id":1342,"text":"I'm not a real fish, I'm just a mere plushy.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"ANH_DAO","is_unapproved":false,"translations":[{"id":423383,"text":"\u6211\u4e0d\u662f\u4e00\u6761\u771f\u7684\u9c7c\uff0c\u6211\u53ea\u662f\u4e00\u4e2a\u957f\u6bdb\u7ed2\u73a9\u5177\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1345,"text":"I've always wondered what it'd be like to have siblings.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"human600","is_unapproved":false,"translations":[{"id":501323,"text":"\u6211\u603b\u662f\u60f3\u6709\u5144\u5f1f\u59d0\u59b9\u4f1a\u600e\u4e48\u6837\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1347,"text":"It would take forever for me to explain everything.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":475247,"text":"\u6211\u5c31\u7b97\u8aaa\u4e0a\u4e09\u5929\u4e09\u591c\uff0c\u6050\u6015\u4e5f\u4e0d\u80fd\u628a\u4e00\u5207\u89e3\u91cb\u6e05\u695a\u3002","lang":"cmn","script":"Hant","license":"CC BY 2.0 FR","owner":"nickyeow","is_unapproved":false,"is_direct":true},{"id":501325,"text":"\u8981\u90fd\u89e3\u91ca\u7684\u8bdd\uff0c\u9700\u8981\u4e00\u8f88\u5b50\u7684\u65f6\u95f4\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1353,"text":"Let's consider the worst that could happen.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"human600","is_unapproved":false,"translations":[{"id":501331,"text":"\u8003\u8651\u4e00\u4e0b\u6700\u574f\u7684\u60c5\u51b5\u4e0b\u4f1a\u53d1\u751f\u4ec0\u4e48\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1359,"text":"I'd be unhappy, but I wouldn't kill myself.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":54,"text":"\u6211\u4f1a\u4e0d\u9ad8\u5174\uff0c\u4f46\u6211\u4e0d\u4f1a\u81ea\u6740\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1363,"text":"I thought you liked to learn new things.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":344585,"text":"\u6211\u4ee5\u70ba\u4f60\u559c\u6b61\u5b78\u7fd2\u65b0\u4e8b\u7269\u3002","lang":"cmn","script":"Hant","license":"CC BY 2.0 FR","owner":"nickyeow","is_unapproved":false,"is_direct":true}]},{"id":1365,"text":"If I could send you a marshmallow, Trang, I would.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":501338,"text":"Trang\uff0c\u5982\u679c\u6211\u80fd\u5bc4\u7ed9\u4f60\u4e00\u4e2a\u68c9\u82b1\u7cd6\uff0c\u6211\u4f1a\u8fd9\u4e48\u505a\u7684\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1366,"text":"In order to do that, you have to take risks.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":501339,"text":"\u8981\u8fd9\u4e48\u505a\uff0c\u4f60\u9700\u8981\u5192\u9669\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1369,"text":"I am not an artist. I never had the knack for it.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"human600","is_unapproved":false,"translations":[{"id":13113773,"text":"\u6211\u4e0d\u662f\u85dd\u8853\u5bb6\uff0c\u6211\u4e00\u9ede\u90a3\u65b9\u9762\u7684\u5929\u8ce6\u90fd\u6c92\u6709\u3002","lang":"cmn","script":"Hant","license":"CC BY 2.0 FR","owner":"LeviHighway","is_unapproved":false,"is_direct":true}]},{"id":1381,"text":"I do not have an account in these forums.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Sbgodin","is_unapproved":false,"translations":[{"id":501352,"text":"\u6211\u5728\u8fd9\u4e9b\u8bba\u575b\u4e0a\u6ca1\u6709\u5e10\u53f7\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1383,"text":"I didn't know where it came from.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"brauliobezerra","is_unapproved":false,"translations":[{"id":58,"text":"\u6211\u4e0d\u77e5\u9053\u5b83\u662f\u4ece\u54ea\u91cc\u6765\u7684\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1384,"text":"I think my living with you has influenced your way of living.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"adrifsa","is_unapproved":false,"translations":[{"id":501355,"text":"\u6211\u89c9\u5f97\u6211\u548c\u4f60\u4e00\u8d77\u4f4f\u5f71\u54cd\u4e86\u4f60\u751f\u6d3b\u7684\u65b9\u5f0f\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1388,"text":"You're just running away from life's problems.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":501364,"text":"\u4f60\u53ea\u4f1a\u9003\u907f\u751f\u6d3b\u95ee\u9898\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1390,"text":"There's a problem there that you don't see.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"human600","is_unapproved":false,"translations":[{"id":501366,"text":"\u6709\u4e2a\u95ee\u9898\u4f60\u6ca1\u6709\u60f3\u5230\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1392,"text":"My physics teacher doesn't care if I skip classes.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"LittleBoy","is_unapproved":false,"translations":[{"id":358065,"text":"\u6211\u7684\u7269\u7406\u8001\u5e08\u4e0d\u5728\u4e4e\u6211\u662f\u5426\u9003\u8bfe\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"mountaintree","is_unapproved":false,"is_direct":true}]},{"id":1399,"text":"Even though he apologized, I'm still furious.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"human600","is_unapproved":false,"translations":[{"id":454663,"text":"\u5373\u4f7f\u4ed6\u9053\u6b49\u4e86\uff0c\u6211\u8fd8\u662f\u5f88\u6124\u6012\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"peipei","is_unapproved":false,"is_direct":true},{"id":471549,"text":"\u96d6\u7136\u4ed6\u9053\u6b49\u4e86\uff0c\u4f46\u6211\u9084\u662f\u5f88\u751f\u6c23\u3002","lang":"cmn","script":"Hant","license":"CC BY 2.0 FR","owner":"nickyeow","is_unapproved":false,"is_direct":true}]},{"id":1400,"text":"The police will get you to find the bullets.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"adrifsa","is_unapproved":false,"translations":[{"id":501392,"text":"\u8b66\u5bdf\u4f1a\u8ba9\u4f60\u53bb\u627e\u5b50\u5f39\u7684\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1417,"text":"I need to ask you a silly question.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":501415,"text":"\u6211\u5fc5\u987b\u95ee\u4f60\u4e00\u4e2a\u8822\u95ee\u9898\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1430,"text":"I will play Sudoku then instead of continuing to bother you.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"wakaran","is_unapproved":false,"translations":[{"id":335063,"text":"\u90a3\u6211\u5c31\u4e0d\u7ee7\u7eed\u6253\u6270\u4f60\uff0c\u73a9\u6570\u72ec\u6e38\u620f\u53bb\u4e86\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1438,"text":"I don't want to wait that long.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":332935,"text":"\u6211\u4e0d\u60f3\u7b49\u90a3\u4e48\u4e45\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1454,"text":"Seriously though, episode 21 made me almost cry while laughing.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"wuiwie","is_unapproved":false,"translations":[{"id":335043,"text":"\u4f46\u662f\u8bf4\u771f\u7684\uff0c\u7b2c21\u96c6\u8ba9\u6211\u7b11\u5f97\u773c\u6cea\u90fd\u8981\u51fa\u6765\u4e86\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1456,"text":"How could I be a robot? Robots don't dream.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":335041,"text":"\u6211\u600e\u4e48\u53ef\u80fd\u662f\u673a\u5668\u4eba\u5462\uff1f\u673a\u5668\u4eba\u4e0d\u4f1a\u505a\u68a6\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1459,"text":"I don't know if I still have it.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":335038,"text":"\u6211\u4e0d\u77e5\u9053\u6211\u8fd8\u6709\u6ca1\u6709\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1460,"text":"What do you think I've been doing?","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":335037,"text":"\u4f60\u89c9\u5f97\u6211\u4e4b\u524d\u5728\u505a\u4ec0\u4e48\uff1f","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1462,"text":"My mom doesn't speak English very well.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":335027,"text":"\u6211\u5988\u5988\u82f1\u8bed\u8bf4\u5f97\u4e0d\u592a\u597d\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1464,"text":"I was wondering if you were going to show up today.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":334925,"text":"\u6211\u5728\u60f3\u4f60\u4eca\u5929\u4f1a\u4e0d\u4f1a\u6765\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1466,"text":"How do you find food in outer space?","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":334923,"text":"\u4f60\u600e\u4e48\u5728\u592a\u7a7a\u91cc\u627e\u5230\u98df\u7269\uff1f","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1467,"text":"All you can do is trust one another.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"wakaran","is_unapproved":false,"translations":[{"id":335711,"text":"\u4f60\u4eec\u9664\u4e86\u4fe1\u4efb\u5bf9\u65b9\uff0c\u6ca1\u4ec0\u4e48\u8981\u505a\u7684\u4e86\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1468,"text":"Everyone wants to meet you. You're famous!","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CK","is_unapproved":false,"translations":[{"id":334921,"text":"\u5927\u5bb6\u90fd\u60f3\u89c1\u5230\u4f60\uff0c\u4f60\u592a\u6709\u540d\u4e86\uff01","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1472,"text":"Whatever I do, she says I can do better.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":334917,"text":"\u4e0d\u7ba1\u6211\u505a\u4ec0\u4e48\uff0c\u5979\u90fd\u8bf4\u6211\u80fd\u505a\u5f97\u66f4\u597d\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1474,"text":"You'd be surprised what you can learn in a week.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CM","is_unapproved":false,"translations":[{"id":334915,"text":"\u4f60\u4f1a\u5f88\u60ca\u8bb6\u4f60\u5728\u4e00\u5468\u5185\u80fd\u5b66\u5230\u591a\u5c11\u4e1c\u897f\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1475,"text":"I don't have anyone who'd travel with me.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"CM","is_unapproved":false,"translations":[{"id":334914,"text":"\u6211\u6ca1\u6709\u4e00\u4e2a\u613f\u610f\u8ddf\u6211\u4e00\u8d77\u65c5\u884c\u7684\u4eba\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1479,"text":"Stop it! You're making her feel uncomfortable!","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"Zifre","is_unapproved":false,"translations":[{"id":334912,"text":"\u5f97\u4e86\uff01\u4f60\u5f04\u5f97\u5979\u4e0d\u81ea\u5728\u4e86\uff01","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1487,"text":"I have too many things on my mind these days.","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"kebukebu","is_unapproved":false,"translations":[{"id":334712,"text":"\u8fd9\u51e0\u5929\u6211\u8111\u888b\u91cc\u7684\u4e8b\u60c5\u592a\u591a\u4e86\u3002","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1489,"text":"Do you really need to ask the question to know the answer?","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"brauliobezerra","is_unapproved":false,"translations":[{"id":334710,"text":"\u4f60\u771f\u7684\u9700\u8981\u63d0\u95ee\u9898\u6765\u77e5\u9053\u7b54\u6848\u5417\uff1f","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]},{"id":1490,"text":"You can't expect me to always think of everything!","lang":"eng","script":null,"license":"CC BY 2.0 FR","owner":"wakaran","is_unapproved":false,"translations":[{"id":335712,"text":"\u4f60\u4e0d\u80fd\u6307\u671b\u6211\u4e00\u76f4\u8003\u8651\u5468\u5230\uff01","lang":"cmn","script":"Hans","license":"CC BY 2.0 FR","owner":"fucongcong","is_unapproved":false,"is_direct":true}]}],"paging":{"total":18579,"has_next":true,"next":"https:\/\/api.tatoeba.org\/v1\/sentences?lang=eng&trans%3Alang=cmn&trans%3Ais_direct=yes&is_unapproved=no&is_orphan=no&trans%3Ais_unapproved=no&trans%3Ais_orphan=no&showtrans=matching&limit=60&sort=-created&word_count=8-12&after=0%2C1490"}}
